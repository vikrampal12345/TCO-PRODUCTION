# Copy Checker uses an isolated prefix so it does not collide with other TCO services.
COPY_CHECKER_MODEL_PROVIDER=lm_studio
COPY_CHECKER_MODEL_BASE_URL=http://127.0.0.1:1234/v1
COPY_CHECKER_MODEL_API_KEY=lm-studio
COPY_CHECKER_VISION_MODEL_NAME=qwen2.5-vl-3b-instruct
COPY_CHECKER_EXTRACTION_VERIFIER_MODEL_NAME=qwen.qwen2.5-vl-3b-instruct
COPY_CHECKER_TEXT_MODEL_NAME=qwen/qwen3-4b-2507
COPY_CHECKER_MAX_PDF_PAGES=100

# Comma-separated origins; add your frontend origin when you connect React later.
TCO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
